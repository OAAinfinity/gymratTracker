NODE_ENV=production
CORS_ORIGIN=https://<your-frontend-vercel-domain>
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Use the full private_key value from Firebase service account JSON.
# If needed in Vercel, keep newlines escaped as \n.
FIREBASE_PRIVATE_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Configure webhook URL in Razorpay Dashboard (not as backend env):
# https://<your-backend-domain>/api/payments/webhook

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function hasOnlyFields(data, allowed) {
      return data.keys().hasOnly(allowed);
    }

    function hasRequiredFields(data, required) {
      return data.keys().hasAll(required);
    }

    function isOwnUid(uidValue) {
      return isSignedIn() && uidValue == request.auth.uid;
    }

    function hasGymSubscription() {
      let profile = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return isSignedIn()
        && profile.data != null
        && profile.data.subscriptionPlan in ["monthly", "yearly"]
        && profile.data.subscriptionExpiresAt is timestamp
        && profile.data.subscriptionExpiresAt > request.time;
    }

    function validUserDoc(data) {
      return hasOnlyFields(data, [
          "name",
          "email",
          "goal",
          "weightUnit",
          "measureUnit",
          "accent",
          "goalWeight",
          "age",
          "height",
          "showCalories",
          "subscriptionPlan",
          "subscriptionStatus",
          "subscriptionEndDate",
          "subscriptionExpiresAt",
          "subscriptionActivatedAt",
          "subscriptionPaymentId",
          "subscriptionOrderId",
          "createdAt"
        ])
        && hasRequiredFields(data, [
          "name",
          "email",
          "goal",
          "weightUnit",
          "measureUnit",
          "accent",
          "goalWeight",
          "age",
          "height"
        ])
        && data.name is string
        && data.email is string
        && data.goal is string
        && data.weightUnit is string
        && data.measureUnit is string
        && data.accent is string
        && data.goalWeight is string
        && data.age is string
        && data.height is string
        && (!("showCalories" in data) || data.showCalories is bool)
        && (!("subscriptionPlan" in data) || data.subscriptionPlan in ["none", "monthly", "yearly"])
        && (!("subscriptionStatus" in data) || data.subscriptionStatus is string)
        && (!("subscriptionEndDate" in data) || data.subscriptionEndDate is string)
        && (!("subscriptionExpiresAt" in data) || data.subscriptionExpiresAt is timestamp || data.subscriptionExpiresAt == null)
        && (!("subscriptionActivatedAt" in data) || data.subscriptionActivatedAt is timestamp || data.subscriptionActivatedAt == null)
        && (!("subscriptionPaymentId" in data) || data.subscriptionPaymentId is string)
        && (!("subscriptionOrderId" in data) || data.subscriptionOrderId is string)
        && (!("createdAt" in data) || data.createdAt is timestamp);
    }

    function validWeightDoc(data) {
      return hasOnlyFields(data, ["uid", "weight", "date", "note", "createdAt"])
        && hasRequiredFields(data, ["uid", "weight", "date"])
        && data.uid is string
        && data.weight is number
        && data.weight > 0
        && data.date is string
        && (!("note" in data) || data.note is string)
        && (!("createdAt" in data) || data.createdAt is timestamp);
    }

    function validUserDailyMeasurementDoc(data, dateKey) {
      return hasOnlyFields(data, [
          "dateKey",
          "date",
          "waist",
          "chest",
          "hips",
          "thigh",
          "arms",
          "notes",
          "updatedAt"
        ])
        && hasRequiredFields(data, ["dateKey", "date", "waist", "chest", "hips", "thigh", "arms"])
        && data.dateKey is string
        && data.dateKey == dateKey
        && data.date is timestamp
        && data.waist is number
        && data.waist >= 0
        && data.chest is number
        && data.chest >= 0
        && data.hips is number
        && data.hips >= 0
        && data.thigh is number
        && data.thigh >= 0
        && data.arms is number
        && data.arms >= 0
        && (!("notes" in data) || data.notes is string)
        && (!("updatedAt" in data) || data.updatedAt is timestamp);
    }

    function validWorkoutDoc(data) {
      return hasOnlyFields(data, [
          "uid",
          "exercise",
          "sets",
          "reps",
          "weight",
          "muscle",
          "rpe",
          "date",
          "note",
          "createdAt"
        ])
        && hasRequiredFields(data, ["uid", "exercise", "sets", "reps", "weight", "muscle", "rpe", "date"])
        && data.uid is string
        && data.exercise is string
        && data.sets is number
        && data.sets > 0
        && data.reps is number
        && data.reps > 0
        && data.weight is number
        && data.weight >= 0
        && data.muscle is string
        && data.rpe is number
        && data.rpe >= 0
        && data.rpe <= 10
        && data.date is string
        && (!("note" in data) || data.note is string)
        && (!("createdAt" in data) || data.createdAt is timestamp);
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && validUserDoc(request.resource.data);
      allow delete: if isOwner(uid);

      match /measurements/{dateKey} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && validUserDailyMeasurementDoc(request.resource.data, dateKey);
        allow delete: if isOwner(uid);
      }
    }

    match /weights/{docId} {
      allow read: if isSignedIn() && isOwnUid(resource.data.uid);
      allow create: if isSignedIn()
        && isOwnUid(request.resource.data.uid)
        && validWeightDoc(request.resource.data);
      allow update: if isSignedIn()
        && isOwnUid(resource.data.uid)
        && isOwnUid(request.resource.data.uid)
        && validWeightDoc(request.resource.data);
      allow delete: if isSignedIn() && isOwnUid(resource.data.uid);
    }

    match /workouts/{docId} {
      allow read: if isSignedIn() && hasGymSubscription() && isOwnUid(resource.data.uid);
      allow create: if isSignedIn()
        && hasGymSubscription()
        && isOwnUid(request.resource.data.uid)
        && validWorkoutDoc(request.resource.data);
      allow update: if isSignedIn()
        && hasGymSubscription()
        && isOwnUid(resource.data.uid)
        && isOwnUid(request.resource.data.uid)
        && validWorkoutDoc(request.resource.data);
      allow delete: if isSignedIn() && hasGymSubscription() && isOwnUid(resource.data.uid);
    }
  }
}
